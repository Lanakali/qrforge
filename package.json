{
  "name": "qrforge",
  "version": "1.0.0",
  "description": "QRForge — QR code generation API. Turn text into PNG/SVG QR codes with a simple REST API.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/smoke.js",
    "build:vendor": "esbuild node_modules/qrcode/lib/browser.js --bundle --format=iife --global-name=QRCode --minify --target=es2017 --outfile=public/js/vendor/qrcode.min.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "qr",
    "qr-code",
    "api",
    "saas",
    "rest"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "stripe": "^18.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
