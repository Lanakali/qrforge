# --- Server ---
PORT=3000
# Public base URL of your deployment. Used in Stripe return URLs and doc links.
APP_URL=https://your-app.example.com
# Where SQLite stores data (created automatically)
DATABASE_PATH=./data/qrforge.db

# --- Stripe (billing) ---
# Leave STRIPE_SECRET_KEY empty to run in "free tier only" mode (billing endpoints
# return 503 until configured).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for the monthly plans (create in Dashboard -> Products):
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_BUSINESS_ID=

# --- Local development only ---
# Set to 1 to accept webhook payloads without a Stripe signature (no-Stripe-CLI dev).
# NEVER set this in production.
ALLOW_UNVERIFIED_WEBHOOKS=0
